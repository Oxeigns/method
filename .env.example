APP_ENV=local
BOT_TOKEN=
ADMIN_ID=
DATA_DIR=./data
# Leave DATABASE_URL empty for persistent SQLite on your own machine.
DATABASE_URL=
# PostgreSQL requires a stable key shared by every web/worker process.
MASTER_ENCRYPTION_KEYS=
MIGRATION_DATABASE_URL=
DB_POOL_MAX=5
# Native Telethon commands/broadcasts. True by default in production.
TELETHON_ENABLED=false
API_ID=
API_HASH=
BROADCAST_RATE=8
# Web dashboard requires both of these. Generate using scripts/secrets.py.
SECRET_KEY=
DASHBOARD_PASSWORD_HASH=
PUBLIC_ORIGIN=http://localhost:8000
TRUST_PROXY=false
SUPPORT_USERNAME=
PAYMENT_MODE=stars
ACKNOWLEDGE_UPI_PLATFORM_RESTRICTION=false
